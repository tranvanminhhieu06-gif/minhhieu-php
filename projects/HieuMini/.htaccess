# =====================================================================
#  HieuMini - Cấu hình Apache
#  Đặt tại thư mục gốc của dự án. Cần bật mod_rewrite, mod_deflate, mod_expires.
# =====================================================================

# ---------- Trang lỗi tuỳ chỉnh ----------
# LƯU Ý: Apache yêu cầu đường dẫn TUYỆT ĐỐI tính từ thư mục gốc của máy chủ web.
# Nếu bạn đặt dự án ở vị trí khác, hãy sửa lại dòng dưới cho khớp. Ví dụ:
#   - Đặt tại htdocs/HieuMini        ->  ErrorDocument 404 /HieuMini/404.php
#   - Đặt tại thư mục gốc tên miền   ->  ErrorDocument 404 /404.php
ErrorDocument 404 /DoAnWebsite/projects/HieuMini/404.php

# ---------- Bảo vệ tệp nhạy cảm ----------
<FilesMatch "\.(sql|md|py|log|ini)$">
  Require all denied
</FilesMatch>
<Files ".htaccess">
  Require all denied
</Files>
<Files ".antigravityrules">
  Require all denied
</Files>

# Cấm liệt kê thư mục
Options -Indexes

# LƯU Ý: việc cấm thực thi PHP trong thư mục tải lên được đặt tại
# uploads/.htaccess, KHÔNG dùng khối <Directory> ở đây vì Apache
# không cho phép <Directory> bên trong tệp .htaccess (gây lỗi 500).

# ---------- Đường dẫn thân thiện (tuỳ chọn) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # /du-an/<slug>  ->  project-detail.php?slug=<slug>
  RewriteRule ^du-an/([a-z0-9-]+)/?$ project-detail.php?slug=$1 [L,QSA]

  # /danh-muc/<slug>  ->  projects.php?cat=<slug>
  RewriteRule ^danh-muc/([a-z0-9-]+)/?$ projects.php?cat=$1 [L,QSA]

  # /bai-viet/<slug>  ->  blog-detail.php?slug=<slug>
  RewriteRule ^bai-viet/([a-z0-9-]+)/?$ blog-detail.php?slug=$1 [L,QSA]

  # sitemap.xml -> sitemap.php
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# ---------- Nén nội dung ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---------- Bộ nhớ đệm trình duyệt ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml  "access plus 1 year"
  ExpiresByType image/webp     "access plus 1 year"
  ExpiresByType image/jpeg     "access plus 1 year"
  ExpiresByType image/png      "access plus 1 year"
  ExpiresByType text/css       "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html      "access plus 0 seconds"
</IfModule>

# ---------- Tiêu đề bảo mật ----------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---------- Bảng mã mặc định ----------
AddDefaultCharset UTF-8
